-- Basic put - single cell expression (no adjustment)
let A0 = 10
let B0 = A0 + 5
:yank B0

-- C0 becomes A0 + 5 (literal copy)
:p C0

:expect-eql-number A0 10
:expect-eql-number B0 15
:expect-eql-number C0 15

-- Change A0, B0 and C0 should update
let A0 = 20
:expect-eql-number A0 20
:expect-eql-number B0 25
:expect-eql-number C0 25

-- Basic put - range expression (no adjustment)
:fill A1:E1 1 1

-- A1 B1 C1 D1 E1
--  1  2  3  4  5

let F1 = @sum(B1:D1)

-- Should be 2 + 3 + 4
:expect-eql-number F1 9

:yank F1
:p G1

-- F1 was `@sum(B1:D1)`. Pasted at G1, it should remain `@sum(B1:D1)`.
-- The value should still be 2 + 3 + 4 = 9.
:expect-eql-number G1 9

-- Basic put - multiple cell references (no adjustment)
let A2 = 1
let B2 = 2
let C2 = A2 + B2
:yank C2
:p D2

-- D2 should be A2 + B2 (literal copy)
-- Value should be 1 + 2 = 3
:expect-eql-number A2 1
:expect-eql-number B2 2
:expect-eql-number C2 3
:expect-eql-number D2 3

let A2 = 10
let B2 = 20
:expect-eql-number A2 10
:expect-eql-number B2 20
:expect-eql-number C2 30
-- D2 should still track A2 + B2
-- Value should be 10 + 20 = 30
:expect-eql-number D2 30

-- Range references in Builtin Functions - no adjustment
let A3 = 1
let B3 = 2
let C3 = 3
let D3 = 4
let E3 = @sum(A3:D3)
:yank E3
:p F3

:expect-eql-number A3 1
:expect-eql-number B3 2
:expect-eql-number C3 3
:expect-eql-number D3 4
:expect-eql-number E3 10
-- F3 should be @sum(A3:D3) (range copied literally)
-- F3's value should be 1 + 2 + 3 + 4 = 10
:expect-eql-number F3 10

let A3 = 10
-- E3's value changes: 10+2+3+4 = 19
:expect-eql-number E3 19
-- F3's value changes: 10+2+3+4 = 19
:expect-eql-number F3 19

-- String concatenation (#) with cell references - no adjustment
let A4 = 'World'
let B4 = 'Hello ' # A4
:yank B4
:p C4

:expect-eql-string A4 'World'
:expect-eql-string B4 'Hello World'
-- C4 should be 'Hello ' # A4 (literal copy)
-- Value should be 'Hello ' + 'World' = 'Hello World'
:expect-eql-string C4 'Hello World'

let A4 = 'Cellulator'
:expect-eql-string A4 'Cellulator'
:expect-eql-string B4 'Hello Cellulator'
-- C4 should track A4
-- Value should be 'Hello ' + 'Cellulator' = 'Hello Cellulator'
:expect-eql-string C4 'Hello Cellulator'

-- Builtin functions with single cell argument (@upper, @lower) - no adjustment
let A5 = 'Test String'
let B5 = @upper(A5)
:yank B5
:p C5

:expect-eql-string A5 'Test String'
:expect-eql-string B5 'TEST STRING'
-- C5 should be @upper(A5) (literal copy)
:expect-eql-string C5 'TEST STRING'

let A5 = 'another test'
:expect-eql-string A5 'another test'
:expect-eql-string B5 'ANOTHER TEST'
-- C5 should track A5
:expect-eql-string C5 'ANOTHER TEST'

-- Pasting a range of expressions with inter-dependencies - no adjustment
let A6 = 10
let B6 = A6 * 2
let A7 = B6 + 5
let B7 = A7 / 2
:yank A6:B7
-- Paste to C8 (2 columns right, 2 rows down from A6)
:p C8

-- Original values
:expect-eql-number A6 10
:expect-eql-number B6 20
:expect-eql-number A7 25
:expect-eql-number B7 12.5

-- Expected literal expressions in the pasted range:
-- C8 (from A6) should be 10 (value)
-- D8 (from B6) should be A6 * 2
-- C9 (from A7) should be B6 + 5
-- D9 (from B7) should be A7 / 2

:expect-eql-number C8 10
:expect-eql-number D8 20
:expect-eql-number C9 25
:expect-eql-number D9 12.5

let A6 = 1
:expect-eql-number A6 1
:expect-eql-number B6 2
:expect-eql-number A7 7
:expect-eql-number B7 3.5

-- After A6 changes, the original cells A6, B6, A7, B7 update.
-- The pasted cells C8, D8, C9, D9 also update, as their expressions are literal copies of the original.
-- C8 was a literal value, so it does not change.
:expect-eql-number C8 10
-- D8's expression is A6 * 2, A6 is now 1.
:expect-eql-number D8 2
-- C9's expression is B6 + 5, B6 is now 2.
:expect-eql-number C9 7
-- D9's expression is A7 / 2, A7 is now 7.
:expect-eql-number D9 3.5

-- Undo/Redo - with literal expressions
let A10 = 10
let B10 = A10 + 1
:yank B10
:p C10

:expect-eql-number A10 10
:expect-eql-number B10 11
-- C10 is A10 + 1 (literal copy)
-- Value should be 10 + 1 = 11
:expect-eql-number C10 11

-- Undo p C10
:undo
:expect-eql-number A10 10
:expect-eql-number B10 11
:expect-non-extant C10

-- Undo let B10
:undo
:expect-eql-number A10 10
:expect-non-extant B10
:expect-non-extant C10

-- Redo let B10
:redo
:expect-eql-number A10 10
:expect-eql-number B10 11
:expect-non-extant C10

-- Redo p C10
:redo
:expect-eql-number A10 10
:expect-eql-number B10 11
:expect-eql-number C10 11

let A10 = 5
:expect-eql-number A10 5
:expect-eql-number B10 6
-- C10 (A10 + 1) should be 5 + 1 = 6
:expect-eql-number C10 6

-- Undo let A10 = 5
:undo
:expect-eql-number A10 10
:expect-eql-number B10 11
:expect-eql-number C10 11

-- Overwrite existing cell with literal expression
let A11 = 10
let B11 = A11 * 2
let C11 = 50
:expect-eql-number A11 10
:expect-eql-number B11 20
:expect-eql-number C11 50

:yank B11
-- Overwrite C11 with literal expression
:p C11

:expect-eql-number A11 10
:expect-eql-number B11 20
-- C11 should now be A11 * 2
-- Value should be 10 * 2 = 20
:expect-eql-number C11 20

let A11 = 5
:expect-eql-number A11 5
:expect-eql-number B11 10
-- C11 (A11 * 2) should be 5 * 2 = 10
:expect-eql-number C11 10

-- Yank cell with an error and paste (literal)
-- Circular reference, causes error
let A12 = A12
:yank A12
:p B12

:expect-error A12
-- B12 should also be an error (circular reference to A12, literally copied)
:expect-error B12

-- Fix A12
let A12 = 10
:expect-eql-number A12 10
-- B12's expression is still A12, so it should resolve to 10
:expect-eql-number B12 10

-- Pasting a string literal (no adjustment needed)
let A13 = 'Hello World'
:yank A13
:p B13

:expect-eql-string A13 'Hello World'
:expect-eql-string B13 'Hello World'

let A13 = 'Goodbye'
:expect-eql-string A13 'Goodbye'
-- String paste copies the literal value, not an expression that tracks A13
:expect-eql-string B13 'Hello World'

-- Pasting a number literal (no adjustment needed)
let A14 = 123
:yank A14
:p B14

:expect-eql-number A14 123
:expect-eql-number B14 123

let A14 = 456
:expect-eql-number A14 456
-- Number paste copies the literal value, not an expression that tracks A14
:expect-eql-number B14 123

